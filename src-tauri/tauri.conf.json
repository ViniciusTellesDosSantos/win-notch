{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "win-notch",
  "version": "0.1.0",
  "identifier": "dev.winnotch.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "index.html",
        "title": "win-notch",
        "width": 136,
        "height": 56,
        "minWidth": 56,
        "minHeight": 56,
        "x": 880,
        "y": 0,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "popover",
        "url": "popover.html",
        "title": "win-notch",
        "width": 300,
        "height": 208,
        "x": -10000,
        "y": -10000,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
