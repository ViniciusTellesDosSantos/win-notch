{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "win-notch",
  "version": "0.2.0",
  "identifier": "dev.winnotch.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
